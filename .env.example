# ===== Авито =====
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=0
POLL_INTERVAL_SEC=8

# ===== Poe: один вынесенный бот, промпт уже в нём =====
POE_API_KEY=
POE_BASE_URL=https://api.poe.com/v1
POE_RESPONSE_BOT=IlyaDemoBal-Manager
SEND_SYSTEM_PROMPTS=false
HISTORY_LIMIT=40

COMPANY_NAME=Центр-Балкон
MANAGER_NAME=Алексей

# Push: 09:00–18:00 МСК. Pull (ответ на входящее) — круглосуточно.
TIMEZONE=Europe/Moscow
PUSH_HOUR_START=9
PUSH_HOUR_END=18
FOLLOWUP_ENABLED=true
FOLLOWUP_DELAY_SEC=14400

FAST_MODE=0
REPLY_DELAY_MIN_SEC=5
REPLY_DELAY_MAX_SEC=8

# Telegram Bot API: лиды в группу. Бота добавить в группу.
TG_BOT_TOKEN=
TG_LEAD_CHAT_ID=
